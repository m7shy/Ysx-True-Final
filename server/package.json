{
  "name": "secure-mail-gateway",
  "version": "1.0.0",
  "description": "Secure IMAP/SMTP Gateway Backend",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p .",
    "start": "node --enable-source-maps dist/index.js",
    "lint": "tsc --noEmit",
    "test": "vitest",
    "test:smoke": "bash scripts/smoke.sh",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "imapflow": "^1.0.151",
    "jsonwebtoken": "^9.0.3",
    "mailparser": "^3.7.4",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "pino": "^9.0.0",
    "prom-client": "^15.1.0",
    "stripe": "^22.3.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mailparser": "^3.4.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^6.4.14",
    "@types/supertest": "^6.0.2",
    "pino-pretty": "^13.1.3",
    "prisma": "^6.2.0",
    "supertest": "^6.3.4",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vitest": "^4.0.16"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
