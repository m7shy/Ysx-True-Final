// YSX Flow — Phase 1 multi-tenant schema (PostgreSQL on Neon via Prisma).
// Four models only: User, Mailbox, Lead, Campaign.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (PgBouncer) for the app runtime.
  url       = env("DATABASE_URL")
  // Direct (non-pooled) connection for migrations / introspection.
  directUrl = env("DIRECT_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

// Both providers are OAuth2 going forward (Gmail migrating off app-passwords).
enum MailboxProvider {
  GMAIL
  MICROSOFT
}

enum LeadStatus {
  NEW
  CONTACTED
  REPLIED
  CALL_BOOKED
  TRIAL
  CLIENT_CLOSED
  LOST
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENT
  ACTIVE
  PAUSED
  COMPLETED
}

// ── Models ────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String

  // JWT session tracking. tokenVersion is bumped to invalidate all issued JWTs
  // (logout-everywhere / password reset). lastLoginAt is informational.
  tokenVersion Int       @default(0)
  lastLoginAt  DateTime?

  // Email signature(s) and user settings. JSON because these are variable,
  // nested, UI-owned blobs (multiple named signatures, tone/prefs) that the app
  // never filters or aggregates on in SQL. Matches existing UserSettings shape.
  signatures Json? // e.g. [{ name, html, isDefault }]
  settings   Json? // e.g. { defaultTone, syncLookbackDays, autoSync, ... }

  mailboxes Mailbox[]
  leads     Lead[]
  campaigns Campaign[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Mailbox {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Sending identity.
  email    String
  provider MailboxProvider

  // ── OAuth token record (mirrors the real persisted shape:
  //    { tenant, scope, tokenType:'Bearer', accessToken, refreshToken,
  //      obtainedAt, expiresAt } ).
  //    SECRET: accessToken/refreshToken are secrets — encryption-at-rest is an
  //    app concern (encrypt before write, decrypt on read); DB stores ciphertext.
  accessToken  String? // ciphertext
  refreshToken String? // ciphertext, may rotate on refresh
  scope        String?
  tokenType    String  @default("Bearer")
  tenant       String? // MS tenant id ("common" or a GUID); null for Gmail

  // Expiry timestamps. Stored as DateTime (Postgres timestamptz) rather than the
  // legacy ms-epoch numbers so the rotation engine can compare/order in SQL.
  // The 5-minute refresh buffer stays in app logic.
  obtainedAt DateTime?
  expiresAt  DateTime? // rotation engine treats null / <= now()+buffer as "needs refresh"

  // ── Rotation & throttling: scalar columns so the rotation engine can filter,
  //    order, and aggregate a healthy sending mailbox directly in SQL.
  dailyLimit  Int       @default(0) // max sends per UTC day (0 = not yet warmed / disabled)
  sentToday   Int       @default(0) // consumed today; app resets to 0 at UTC midnight
  counterDate DateTime  @default(now()) @db.Date // UTC day sentToday belongs to; stale date => treat as reset
  lastSentAt  DateTime? // for pacing / round-robin fairness across mailboxes

  // Health gate for rotation: a disabled mailbox (auth failure, bounce spike,
  // manual pause) is skipped without being deleted. A single boolean is enough
  // for Phase 1; a reason/timestamp is deferred until there's a UI for it.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Email is unique PER TENANT (per user), not globally: two users may both
  // connect the same shared/alias inbox.
  @@unique([userId, email])
  // Rotation-engine hot path: "this user's active mailboxes".
  @@index([userId, isActive])
  // Lazy refresh-on-read: find a user's mailboxes with near-expiry tokens
  // (matches the per-mailbox refresh in microsoftOauth.ts). A cross-tenant
  // background sweep would instead want a standalone @@index([expiresAt]).
  @@index([userId, expiresAt])
}

model Lead {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name    String
  email   String
  company String?
  status  LeadStatus @default(NEW)

  // Existing Lead scalars.
  source        String?
  notes         String?
  score         Int?      // filtered/sorted on for prioritization → scalar column
  lastContacted DateTime?

  // LeadIntelligence: variable nested blob
  // ({ postingFrequency, hasPaidCommunity, offerType, targetKeywords[],
  //   lastPostDate }). Not filtered/aggregated in SQL → JSON is the right fit.
  intelligence Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Lead email is unique PER TENANT (per user), not globally: the same prospect
  // may belong to multiple agency users independently.
  @@unique([userId, email])
  // Pipeline views filter by owner + status; score orders within.
  @@index([userId, status])
  @@index([userId, score])
}

model Campaign {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name   String
  status CampaignStatus @default(DRAFT)

  // Base message + schedule (existing Campaign shape).
  subject     String?
  body        String?
  scheduledAt DateTime?
  progress    Int       @default(0) // 0-100

  // Aggregate stats. Kept as flat scalar columns (not JSON) so dashboards can
  // SUM/ORDER these in SQL. Matches existing stats{ sent, clicked, replied,
  // opportunities }.
  sentCount          Int @default(0)
  clickedCount       Int @default(0)
  repliedCount       Int @default(0)
  opportunitiesCount Int @default(0)

  distributionMethod String? // 'INDIVIDUAL' | 'GROUP' — free-form Phase 1, not queried

  // Variable-length nested step arrays: SequenceStep[]
  // ({ id, step, subject, body, scheduledFor, status, type }) and autoFollowUps[]
  // ({ delay, unit, content }). Authored/consumed as whole documents by the
  // scheduler, never filtered field-by-field in SQL → JSON.
  sequence      Json?
  autoFollowUps Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Campaign list / scheduler sweep by owner + status.
  @@index([userId, status])
  @@index([userId, scheduledAt])
}
