PORT=3001
WEB_ORIGIN=http://localhost:5173
ALLOWLIST_HOSTS=imap.gmail.com,smtp.gmail.com,outlook.office365.com,smtp.office365.com

# Optional: used in the "From:" header when sending mail.
MAIL_FROM_NAME=Your Name

# --- AUTH (JWT) — Phase 2 ---
# Signing secret for access + refresh tokens. REQUIRED in production.
# Generate: openssl rand -hex 48
JWT_SECRET=change-me-to-a-long-random-secret
# Token lifetimes (any `ms`-style string). Defaults: 15m / 30d.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- MAILBOX TOKEN ENCRYPTION (at rest) — Phase 2 ---
# 32-byte key (64 hex chars) used to AES-256-GCM encrypt the OAuth
# accessToken/refreshToken columns on Mailbox before they reach Postgres.
# Required whenever mailbox credentials are read or written.
# Generate: openssl rand -hex 32
MAILBOX_ENCRYPTION_KEY=change-me-64-hex-characters

# --- OAUTH APP REGISTRATIONS (app-level, NOT per-user) ---
# Used to (a) run the interactive connect/consent flow and (b) refresh a
# mailbox's stored refresh token into a new access token. The per-user tokens
# themselves live encrypted on the Mailbox model in the DB.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Optional MS tenant GUID; defaults to "common".
MICROSOFT_TENANT_ID=
# Optional authority override (advanced).
MICROSOFT_OAUTH_AUTHORITY=https://login.microsoftonline.com

# Public base URL of THIS backend, used to build the OAuth redirect_uri:
#   <OAUTH_REDIRECT_BASE_URL>/api/auth/oauth/<provider>/callback
# It must byte-for-byte match the redirect URI registered in the Google / Azure
# app registration. Register these two exact URIs with the providers:
#   http://localhost:3001/api/auth/oauth/gmail/callback      (Google)
#   http://localhost:3001/api/auth/oauth/microsoft/callback  (Microsoft)
# Leave blank to derive it from the incoming request origin (fine for local dev).
OAUTH_REDIRECT_BASE_URL=http://localhost:3001

# --- PHASE 4: CAMPAIGN WORKER + UNIBOX REPLY POLLER ---
# All optional. The worker/poller only start when DATABASE_URL is set.
# CAMPAIGN_TICK_MS      how often the campaign dispatch worker runs (default 60000)
# CAMPAIGN_BATCH_SIZE   max sends per campaign per tick (default 10)
# UNIBOX_POLL_MS        how often inboxes are polled for replies (default 300000)
# UNIBOX_SCAN_LIMIT     max contacted leads scanned per poll (default 100)
#CAMPAIGN_TICK_MS=60000
#CAMPAIGN_BATCH_SIZE=10
#UNIBOX_POLL_MS=300000
#UNIBOX_SCAN_LIMIT=100

# Gemini API key for AI reply-intent categorization (Unibox). When unset, a
# keyword heuristic is used instead. Optional model override.
GEMINI_API_KEY=
#GEMINI_INTENT_MODEL=gemini-2.0-flash

# --- DATABASE (PostgreSQL on Neon) — Phase 1 multi-tenant backend ---
# Neon exposes two connection strings for the same database:
#   DATABASE_URL -> POOLED connection (host contains "-pooler"); used at runtime.
#   DIRECT_URL   -> DIRECT/unpooled connection; used by `prisma migrate`.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"
