{
  "name": "ysx-final-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3000",
    "dev:portal": "vite --config portal/vite.config.ts",
    "build": "vite build",
    "build:portal": "vite build --config portal/vite.config.ts",
    "build:all": "vite build && vite build --config portal/vite.config.ts",
