# Comma-separated list of YouTube Data API v3 keys.
# When one key's daily quota is exhausted the script automatically rotates to the next.
YOUTUBE_API_KEYS=your_first_key_here,your_second_key_here

# Gemini API key — used by orchestrator.py for keyword generation.
# Free keys at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model (default: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# Webhook URL — main.py POSTs a JSON payload here for every qualified lead.
# Leave unset to disable the webhook silently.
# Payload fields: name, url, email, subscribers, avg_views, external_links
# SMARTLEAD_WEBHOOK_URL=https://hooks.your-crm.com/endpoint

# ZeroBounce API key — validates every mined email before it reaches leads.csv.
# Leave unset to disable validation (the gate becomes a no-op).
# ZEROBOUNCE_API_KEY=your_zerobounce_api_key_here

# YSX Flow CRM import (used by crm_importer.py to push leads.csv into the CRM).
# CRM_IMPORT_URL   base URL of the CRM backend (default http://localhost:3001)
# CRM_IMPORT_KEY   shared secret; must equal the server's IMPORT_API_KEY
# CRM_IMPORT_URL=http://localhost:3001
# CRM_IMPORT_KEY=change-me-to-a-long-random-secret

# ── YouTube session cookies ───────────────────────────────────────────────────
# Netscape-format cookies.txt from real, logged-in Google/YouTube sessions
# (export with a browser extension like "Get cookies.txt LOCALLY", filtered to
# ONLY youtube.com/google.com rows — do not export your whole cookie jar). This
# is yt-dlp's own fix for "Sign in to confirm you're not a bot": an
# authenticated session beats IP reputation or browser impersonation alone.
# TREAT THESE FILES LIKE PASSWORDS: never commit them (see .gitignore), never
# bake them into a Docker image (see .dockerignore) — mount/inject at runtime.
#
# The scraper now rotates across a POOL of cookie files (one per account) so no
# single account gets rate-limited or bot-flagged under sustained scraping —
# more accounts means longer runs and more leads. Manage the pool from the CRM
# "Scraper" view (upload/delete), or drop files into the directory below.
#
# YTDLP_COOKIES_DIR — directory of *.txt cookie files to rotate across
# (default: cookies/, relative to this scraper dir). The CRM's cookie-upload
# UI writes here.
# YTDLP_COOKIES_DIR=cookies
#
# YTDLP_COOKIES_FILE — LEGACY single cookie file. Still supported: on first run
# it is auto-copied into YTDLP_COOKIES_DIR as legacy.txt and joins the rotation,
# so existing single-cookie setups keep working with no changes.
# YTDLP_COOKIES_FILE=./cookies.txt
